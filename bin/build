#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
qmake="$(command -v qmake6 || command -v qmake)"
jobs="$(getconf _NPROCESSORS_ONLN 2>/dev/null || printf 1)"
mkdir -p build
"$qmake" steady.pro -o build/Makefile "$@"
make -C build -j"$jobs"
"$qmake" steady-cli.pro -o build/Makefile.cli "$@"
make -C build -f Makefile.cli -j"$jobs"
